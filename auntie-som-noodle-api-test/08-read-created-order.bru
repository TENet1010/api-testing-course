meta {
  name: Read created order
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/orders/{{orderId}}
  body: none
  auth: none
}

tests {
  test("Order lookup returns the same ID, status, and total as creation", function () {
    expect(res.status).to.equal(200);
    expect(res.body.orderId).to.equal(bru.getVar("orderId"));
    expect(res.body.status).to.equal("created");
    expect(res.body.totalPrice).to.equal(bru.getVar("orderTotal"));
  });
}
