meta {
  name: Read menu
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/menu
  body: none
  auth: none
}

script:post-response {
  if (res.status === 200 && Array.isArray(res.body)) {
    const noodles = res.body.find(item => item.id === 1);
    const rice = res.body.find(item => item.id === 2);
    bru.setVar("noodlePrice", noodles?.price);
    bru.setVar("noodleStock", noodles?.stock);
    bru.setVar("riceStock", rice?.stock);
  }
}

tests {
  test("Menu returns HTTP 200 and a list", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
  });

  test("The menu contains the two items with their opening prices and stock", function () {
    expect(res.body.find(item => item.id === 1)).to.deep.include({
      name: "Tom Yum Noodles", price: 50, stock: 2
    });
    expect(res.body.find(item => item.id === 2)).to.deep.include({
      name: "Fried Rice", price: 45, stock: 1
    });
  });
}
